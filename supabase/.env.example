# Edge Function secrets. Copy to supabase/.env.local (gitignored) and push with
#   npm run supabase:secrets
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Linked POS tenants whose inventory is read on staff's behalf. JSON array; the
# shared service logins used to be hardcoded in the app — keep them here only.
# Omit to disable linked systems entirely.
# CGOLD_LINKED_POS_SYSTEMS=[{"key":"gta","label":"Canada Gold GTA","baseUrl":"https://gta.aureuspos.com/api","login":"…","password":"…"},{"key":"pmx","label":"Canadian PMX","baseUrl":"https://canadianpmx.com/api","login":"…","password":"…"}]

# AI providers used by the proxy when no company key is saved in Settings
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public URL of the web app (sent as HTTP-Referer to OpenRouter)
CGOLD_APP_URL=https://www.mycanadagold.ca

# Rippling OAuth app (Developer Portal). Optional — a System Admin can also
# add these from Employees → Rippling. Client secret stays here only.
RIPPLING_CLIENT_ID=
RIPPLING_CLIENT_SECRET=

# Google Workspace mail (Gmail API). Web OAuth client; secret stays here only.
# In Google Cloud → Credentials → Authorized redirect URIs add every host you use,
# with and without a trailing slash. Typical set:
#   https://www.mycanadagold.ca
#   https://www.mycanadagold.ca/
#   https://mycanadagold.ca
#   https://mycanadagold.ca/
#   http://localhost:8081
#   http://localhost:8081/
#   http://127.0.0.1:8081
#   http://127.0.0.1:8081/
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_HOSTED_DOMAIN=canadagold.ca

# Unused for the hours CSV. That inbox signs in with the company Emails app
# above. The old "Canada Gold Hours" client is an unverified test app.
RIPPLING_HOURS_GOOGLE_CLIENT_ID=
RIPPLING_HOURS_GOOGLE_CLIENT_SECRET=

# The hours CSV inbox is edward.anuichi@canadagold.ca. It is fixed in the proxy.
# The secret still lets a mailbox script post CSV files.
RIPPLING_HOURS_GMAIL_USER=
RIPPLING_HOURS_MAILBOX_SECRET=

# RingCentral REST API apps (JWT auth). One set per store; never ship these
# to the client. The proxy upserts them into ringcentral_accounts on first load.
# RINGCENTRAL_MONTREAL_CLIENT_ID=
# RINGCENTRAL_MONTREAL_CLIENT_SECRET=
# RINGCENTRAL_MONTREAL_JWT=
# RINGCENTRAL_STORES=[{"storeKey":"quebec","storeName":"Quebec","clientId":"…","clientSecret":"…","jwt":"…"}]

# Comma-separated browser origins allowed to call the functions (CORS).
# Leave empty to allow any origin (auth is still enforced by JWT).
# Must include the live web host(s); a placeholder here blocks sign-in in the browser.
CGOLD_ALLOWED_ORIGINS=https://www.mycanadagold.ca,https://mycanadagold.ca,http://localhost:8081,http://127.0.0.1:8081
