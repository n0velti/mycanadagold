# Edge Function secrets. Copy to supabase/.env.local (gitignored) and push with
#   npm run supabase:secrets
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Linked POS tenants whose inventory is read on staff's behalf. JSON array; the
# shared service logins used to be hardcoded in the app — keep them here only.
# Omit to disable linked systems entirely.
# CGOLD_LINKED_POS_SYSTEMS=[{"key":"gta","label":"Canada Gold GTA","baseUrl":"https://gta.aureuspos.com/api","login":"…","password":"…"},{"key":"pmx","label":"Canadian PMX","baseUrl":"https://canadianpmx.com/api","login":"…","password":"…"}]

# AI providers used by the proxy when a user has no personal key
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public URL of the web app (sent as HTTP-Referer to OpenRouter)
CGOLD_APP_URL=https://app.mycanadagold.example

# Rippling OAuth app (Developer Portal). Client secret stays here only.
RIPPLING_CLIENT_ID=
RIPPLING_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the functions (CORS).
# Leave empty to allow any origin (auth is still enforced by JWT).
CGOLD_ALLOWED_ORIGINS=https://app.mycanadagold.example,http://localhost:8081
